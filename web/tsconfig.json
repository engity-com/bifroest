{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "/login/test-client.js": ["./src/client.ts"],
      "/_bifroest/test/client.js": ["./src/client.ts"],
      "/src/remember/index.ts": ["./src/remember/index.ts"],
      "/src/remember/protocol.ts": ["./src/remember/protocol.ts"]
    },
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "test", "*.config.ts", "../test/pam/run.ts", "../.github/scripts"]
}
