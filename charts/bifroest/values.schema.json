{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "configuration",
    "persistence",
    "service",
    "monitoring",
    "probes",
    "ingress",
    "networkPolicy",
    "podDisruptionBudget"
  ],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "nameOverride": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 54
    },
    "fullnameOverride": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 54
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "configuration": {
      "oneOf": [{ "type": "object" }, { "type": "string", "minLength": 1 }]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClass", "accessModes", "annotations"],
      "properties": {
        "size": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|Pi|Ei)?$" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod"] }
        },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssh", "http"],
      "properties": {
        "ssh": { "$ref": "#/definitions/service" },
        "http": { "$ref": "#/definitions/service" }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "scheme", "prometheusAnnotations"],
      "properties": {
        "port": { "$ref": "#/definitions/port" },
        "scheme": { "enum": ["HTTP", "HTTPS"] },
        "prometheusAnnotations": { "type": "boolean" }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "host", "path", "annotations", "tlsSecretName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$" },
        "path": { "type": "string", "pattern": "^/([A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*)?$" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "tlsSecretName": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "sshPeers", "httpPeers", "monitoringPeers"],
      "properties": {
        "enabled": { "type": "boolean" },
        "sshPeers": { "$ref": "#/definitions/peers" },
        "httpPeers": { "$ref": "#/definitions/peers" },
        "monitoringPeers": { "$ref": "#/definitions/peers" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 1 }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "env": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "envFrom": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "extraVolumeMounts": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "mountPath"] }
    }
  },
  "definitions": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "type",
        "port",
        "targetPort",
        "annotations",
        "sessionAffinity",
        "loadBalancerSourceRanges"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "$ref": "#/definitions/port" },
        "targetPort": { "$ref": "#/definitions/port" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "sessionAffinity": { "enum": ["None", "ClientIP"] },
        "publishNotReadyAddresses": { "type": "boolean" },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "namespaceSelector": { "type": "object" },
          "podSelector": { "type": "object" },
          "ipBlock": {
            "type": "object",
            "required": ["cidr"],
            "additionalProperties": false,
            "properties": {
              "cidr": { "type": "string", "minLength": 1 },
              "except": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "not": {
          "required": ["ipBlock"],
          "anyOf": [{ "required": ["namespaceSelector"] }, { "required": ["podSelector"] }]
        }
      }
    }
  }
}
